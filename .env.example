# ============================================================
# DIRECT MARKET ACCESS & E-COMMERCE PLATFORM FOR FARMERS
# Copy this file to server/.env and fill in real values for
# anything beyond local demo use. Nothing here is a real secret.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database ---
# Local: mongodb://127.0.0.1:27017/farmer-marketplace
# Atlas: mongodb+srv://<user>:<password>@<cluster>/farmer-marketplace
MONGO_URI=mongodb://127.0.0.1:27017/farmer-marketplace

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# --- Admin bootstrap (used only by the seed script) ---
SEED_ADMIN_EMAIL=admin@farmmarket.demo
SEED_ADMIN_PASSWORD=Admin@12345

# --- Image uploads ---
# UPLOAD_DRIVER = "local" (default, no keys needed) or "cloudinary"
UPLOAD_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments ---
# PAYMENT_MODE = "mock" (default, no real money moves) or "razorpay"
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
